{
  "name": "ai-scientist-vscode-gui",
  "version": "1.0.0",
  "description": "AI Scientist GUI based on VS Code OSS with iteration control",
  "main": "out/main.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "start": "electron .",
    "dev": "npm run compile && npm run start",
    "build": "npm run compile",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.aiscientist.vscode-gui",
    "productName": "AI Scientist GUI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

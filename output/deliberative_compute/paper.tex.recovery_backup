\section{Related work and prior art differentiation}
We position this work relative to core LLM prompting/search methods, metareasoning, and optimization/control.

\paragraph{Prompted reasoning and search in LLMs.}
CoT \cite{wei2022cot} and self-consistency \cite{wang2023selfconsistency} improve LLM reasoning via verbalized steps and multiple samples; tree-of-thought search \cite{yao2023tot} adds branching; debate-style prompting \cite{irving2018debate} explores multi-agent critique; reflective and verifier-augmented frameworks further strengthen reliability \cite{cobbe2021trainverify,lightman2023letsverify,madaan2023selfrefine,shinn2023reflexion,zelikman2022star}. Our focus is complementary: we provide a compute allocation theory (BPF/EVC) and algorithms that schedule deliberation adaptively, with risk-sensitive controls and index-guided policies.

\paragraph{Metareasoning and bounded optimality.}
We build upon metareasoning \cite{russellwefald1991,horvitz1989,liedergriffiths2020}, bandit indices \cite{gittins1979,whittle1988restless}, submodularity \cite{nemhauser1978,golovin2011adaptive}, and risk-sensitive control \cite{howard1972risk, tamar2015risk}. Our contributions connect these principles to inference-time LLM control and provide new sufficient conditions for indexability and anytime guarantees.

\paragraph{Optimization and verification back-ends.}
We leverage dual decomposition and pricing \cite{boyd2011admm}, admissible bounds in branch-and-bound \cite{land1960bb}, and submodular knapsack results \cite{sviridenko2004}. For external memory and retrieval we connect to Memory Networks and Differentiable Neural Computers \cite{weston2015memnn,graves2016dnc} and retrieval-augmented generation \cite{lewis2020rag}.

\paragraph{Cognitive science and neuroscience links.}
We draw on dual-process theories \cite{kahneman2011}, working memory \cite{baddeley1992workingmemory}, cognitive maps and replay \cite{pfeifferfoster2013,gershmandaw2017}, and global workspace dynamics \cite{dehaene2011gnw}. These links ground our algorithms in resource-rational perspectives.

\paragraph{Out-of-scope areas and differentiation.}
We explicitly differentiate from adjacent but distinct literatures:
\begin{itemize}[leftmargin=1.6em, itemsep=0.25em]
\item Data-center right-sizing optimizes power/latency and capacity pools \cite{lin2011rightsizing}; we allocate cognitive actions within a single-instance deliberation.
\item Intertemporal risk economics studies preferences over consumption streams \cite{kreps1978temporal}; we study algorithmic risk in search selection at inference time.
\item Control-theoretic stability and anytime coding aim at plant stabilization over constrained channels; our risk-sensitive selection focuses on sample-based reasoning under compute budgets.
\item Health-disparities research (e.g., BRCA1/2 testing \cite{armstrong2005racial}) concerns access and policy; our work is a computational control framework for LLM reasoning.
\end{itemize}

\section{Methodology}
Our methodology integrates normative optimization with algorithmic blueprints.

\paragraph{Formal target.}
We adopt the BPF $P(B)$ as the performance target under a compute budget $B$, Eq.~\eqref{eq:bpf}, and use EVC (Eq.~\eqref{eq:evc}) as a local decision quantity.

\paragraph{Scheduling principles.}
We unify:
(i) cost-benefit greedy under (adaptive) submodularity for anytime near-optimality;
(ii) index policies for multi-thread scheduling (IGD) with Whittle-style relaxations;
(iii) risk-sensitive selection (RS-MCTT) using entropic risk measures in UCT-like exploration \cite{kocsis2006uct,ahmadi2012entropic};
(iv) dual decomposition for compute markets (DRSM);
(v) admissible bounding for verifiable tasks (BB-LLM).

\paragraph{Evaluation plan.}
We evaluate methods along the BPF, marginal value-of-compute (MVC), reliability at fixed budget, and diversity/verification/memory efficiency. A synthetic illustration is provided (Section~\ref{sec:synthetic}).

\section{Reference system architecture}
Figure~\ref{fig:architecture} depicts a modular architecture that implements our methodology: a fast gating stage, an allocator computing EVC/indices/risks, a reasoner that hosts plug-in algorithms (IGD, RS-MCTT, ADR, APT, DEMI), a verifier layer (PSV/BB-LLM), and an external memory. Algorithm~\ref{alg:igd} gives IGD scheduling with risk-aware stopping; Algorithm~\ref{alg:rsmctt} provides RS-MCTT selection with entropic risk.

\begin{algorithm}[ht]
\centering
\caption{Index-Guided Deliberation (IGD) with risk-aware stopping}
\label{alg:igd}
\begin{adjustbox}{width=\linewidth}
\begin{minipage}{0.98\linewidth}
\begin{algorithmic}[1]
\Require Threads $\{i=1,\dots,m\}$; posterior models for $R_{i,\ell}$; costs $c_i$; discount $\gamma$; risk parameter $\alpha$; compute price $\lambda$
\State Initialize transcripts $h_i \gets \emptyset$, scores $S_i \gets 0$
\While{true}
  \For{each thread $i$}
    \State Estimate discounted marginal return $\widehat{\Delta}_i \gets \sum_{\ell=1}^{n_i} \gamma^{\ell-1} \E[R_{i,\ell}\mid h_i]$
    \State Estimate risk proxy $\sigma_i$ and set lower confidence bound $L_i \gets \widehat{\Delta}_i - \alpha \sigma_i$
    \State Compute index $\tau_i \gets L_i / \left(\sum_{\ell=1}^{n_i} \gamma^{\ell-1} c_i\right)$
  \EndFor
  \State $i^\star \gets \arg\max_i \tau_i$
  \If{$\tau_{i^\star} \le \lambda$} \textbf{break} \Comment{risk-aware EVC stopping}
  \Else
    \State Extend thread $i^\star$ by one micro-action; update $h_{i^\star}$, $S_{i^\star}$
  \EndIf
\EndWhile
\State \Return best-so-far answer across threads
\end{algorithmic}
\end{minipage}
\end{adjustbox}
\end{algorithm}

\begin{algorithm}[ht]
\centering
\caption{Risk-Sensitive Monte Carlo Tree-of-Thought (RS-MCTT)}
\label{alg:rsmctt}
\begin{adjustbox}{width=\linewidth}
\begin{minipage}{0.98\linewidth}
\begin{algorithmic}[1]
\Require Tree root $s_0$; rollouts per iteration $K$; exploration $c_{\text{uct}}$; risk aversion $\eta(d)$ by depth $d$; compute price $\lambda$
\State Initialize counts $N(s)=0$, $N(s,a)=0$, value $Q(s,a)=0$, risk proxy $\rho(s,a)=0$
\While{budget available}
  \State $s \gets s_0$
  \Comment{SELECT}
  \While{$s$ is not terminal and $s$ is fully expanded}
    \For{each $a \in \mathcal{A}(s)$}
      \State $U(s,a) \gets Q(s,a) - \frac{1}{\eta(d(s))}\log \E[\exp(-\eta(d(s))\,R)\mid s,a] + c_{\text{uct}}\sqrt{\frac{\log (N(s)+1)}{N(s,a)+1}}$
    \EndFor
    \State $a^\star \gets \arg\max_a U(s,a)$; $s \gets \text{Child}(s,a^\star)$
  \EndWhile
  \Comment{EXPAND}
  \If{$s$ is not terminal}
    \State Sample action $a$ from LLM prior conditioned on transcript; add child $s'$
  \EndIf
  \Comment{SIMULATE}
  \State Roll out $K$ trajectories using LLM policy with verifier-assisted pruning; collect returns $\{R_k\}_{k=1}^K$
  \Comment{BACKUP}
  \State Let $P \gets$ the path of state-action pairs from $s$ to $s_0$
  \For{each $(\tilde{s},\tilde{a}) \in P$}
    \State $N(\tilde{s}) \gets N(\tilde{s}) + 1$, $N(\tilde{s},\tilde{a}) \gets N(\tilde{s},\tilde{a}) + 1$
    \State $Q(\tilde{s},\tilde{a}) \gets Q(\tilde{s},\tilde{a}) + \frac{1}{K}\sum_{k=1}^K R_k - Q(\tilde{s},\tilde{a})\Big/ N(\tilde{s},\tilde{a})$
    \State $\rho(\tilde{s},\tilde{a}) \gets -\frac{1}{\eta(d(\tilde{s}))}\log\Big(\frac{1}{K}\sum_{k=1}^K e^{-\eta(d(\tilde{s})) R_k}\Big)$
  \EndFor
  \Comment{STOP RULE}
  \If{$\max_{a \in \mathcal{A}(s_0)} \left(\rho(s_0,a) - \lambda\,\text{marginal\_cost}(a)\right) \le 0$}
    \State \textbf{break}
  \EndIf
\EndWhile
\State \Return best leaf by risk-adjusted value at root
\end{algorithmic}
\end{minipage}
\end{adjustbox}
\end{algorithm}


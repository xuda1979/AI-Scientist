\section{Budgeted deliberation: a formalization}

Let $x$ denote an instance drawn from unknown distribution $\mathcal{D}$.
An LLM with parameters $\theta$ interacts with a deliberation environment by producing tokens and invoking cognitive actions $a \in \mathcal{A}$ such as:
\[
\textsc{Propose},\ \textsc{Branch},\ \textsc{Critique},\ \textsc{Verify},\ \textsc{Retrieve},\ \textsc{Revise},\ \textsc{Decide}.
\]
Each action incurs a compute cost $c(a) \ge 0$ (e.g., tokens, wall-clock, FLOPs) and transforms the deliberation state $s_t=(x,h_t)$ where $h_t$ is the transcript of thoughts, branches, and external-memory writes up to time $t$.
At any step, the agent may output a final answer $y$ and stop.

\begin{definition}[Deliberation policy]
A deliberation policy $\pi$ maps states to distributions over actions (including \textsc{Decide}).
Given a utility $U(y;x) \in [0,1]$ measuring solution quality, a compute penalty $\lambda \ge 0$, and a costed trajectory $\tau=(a_1,\dots,a_T,y)$ with cost $C(\tau)=\sum_{t=1}^T c(a_t)$, the expected net utility is
\begin{align}
J(\pi;\lambda) \;=\; \E_{x \sim \mathcal{D},\, \tau \sim \pi}\big[ U(y;x) - \lambda\, C(\tau) \big].
\label{eq:net-utility}
\end{align}
\end{definition}

Equivalently, with a hard budget $B$, we define the Budget--Performance Frontier
\begin{align}
P(B) \;=\; \sup_{\pi:\, \E[C(\tau)] \le B} \; \E\big[ U(y;x) \big].
\label{eq:bpf}
\end{align}
The function $P$ is nondecreasing in $B$; beyond trivial monotonicity, understanding its curvature is key for principled scheduling and stopping.

\begin{assumption}[Diminishing returns]
\label{assump:dimret}
For a given $x$, the expected improvement from adding a set $S$ of cognitive micro-actions exhibits diminishing returns: the set function
$F(S)=\E[U(y;x)\,|\,S\text{ executed}]$ is monotone submodular.
\end{assumption}

\begin{proposition}[Concavity of the BPF under submodularity]
\label{prop:concavity}
Under Assumption~\ref{assump:dimret} and a randomized micro-action cost model with bounded variance, the smoothed frontier $P$ is concave in $B$ to first order. Consequently, the marginal value-of-compute $\partial P / \partial B$ is nonincreasing.
\end{proposition}

\begin{proof}[Proof sketch]
Consider a ground set $\mathcal{S}$ of micro-actions with costs $c_s>0$. For a budget $B$, the relaxed problem maximizes the multilinear extension $f(x)=\E[F(S_x)]$ over $x\in[0,1]^{|\mathcal{S}|}$ subject to $\sum_s c_s x_s \le B$, where $S_x$ is a random set with independent inclusion $x_s$. For a monotone submodular $F$, $f$ is DR-submodular and concave along nonnegative directions. As $B$ increases, the optimal value of a concave program is concave in $B$; smoothing arises from the independence relaxation and finite-variance costs \cite{nemhauser1978,golovin2011adaptive}.
\end{proof}

\paragraph{Expected value of computation (EVC).} At state $s_t$, the EVC of an action $a$ is
\begin{align}
\mathrm{EVC}(a \mid s_t)
= \E\!\left[\, \Delta U \,\middle|\, s_t, a \,\right] \;-\; \lambda\, c(a), \quad
\Delta U 
:= U(y^\star_{t+1};x)-U(y^\star_{t};x),
\label{eq:evc}
\end{align}
where $y^\star_t$ is the best-so-far answer. A greedy-EVC policy that applies the highest positive-EVC action until all EVCs are nonpositive is an anytime procedure.

\begin{theorem}[Greedy near-optimality]
\label{thm:greedy}
Under Assumption~\ref{assump:dimret}, unit-cost micro-actions, and perfect local EVC estimates, the greedy-EVC policy achieves at least a $(1-1/e)$ fraction of the optimal net utility at any budget $B$.
\end{theorem}

\begin{proof}[Proof idea]
Unit-cost micro-actions reduce the problem to maximizing a monotone submodular function subject to a cardinality constraint. The greedy policy that selects the maximum marginal gain at each step attains a $(1-1/e)$ approximation \cite{nemhauser1978}. Since the EVC ordering equals the ordering by marginal gains when $\lambda$ is absorbed into the budget constraint, the result follows.
\end{proof}

\paragraph{Adaptive submodularity.}
When observations arrive during deliberation, the expected marginal gains conditioned on partial transcripts can satisfy adaptive submodularity \cite{golovin2011adaptive}. In this case, a myopic EVC policy that greedily selects the next action by its conditional expected marginal gain per cost achieves a $(1-1/e)$-approximation to the optimal adaptive policy.


\vspace{0.5em}
\noindent\textbf{Pseudocode.} Algorithm~\ref{alg:igd} gives IGD scheduling with risk-aware stopping; Algorithm~\ref{alg:rsmctt} provides RS-MCTT selection with entropic risk.

\vspace{0.5em}
\begin{algorithm}[htbp]
\centering
\caption{Index-Guided Deliberation (IGD) with risk-aware stopping}
\label{alg:igd}
\begin{adjustbox}{width=\linewidth}
\begin{minipage}{0.98\linewidth}
\begin{algorithmic}[1]
\Require Threads $\{i=1,\dots,m\}$; posterior models for $R_{i,\ell}$; costs $c_i$; discount $\gamma$; risk parameter $\alpha$; compute price $\lambda$
\State Initialize transcripts $h_i \gets \emptyset$, scores $S_i \gets 0$
\While{true}
  \For{each thread $i$}
    \State Estimate discounted marginal return $\widehat{\Delta}_i \gets \sum_{\ell=1}^{n_i} \gamma^{\ell-1} \E[R_{i,\ell}\mid h_i]$
    \State Estimate risk proxy $\sigma_i$ and set lower confidence bound $L_i \gets \widehat{\Delta}_i - \alpha \sigma_i$
    \State Compute index $\tau_i \gets L_i / \left(\sum_{\ell=1}^{n_i} \gamma^{\ell-1} c_i\right)$
  \EndFor
  \State $i^\star \gets \arg\max_i \tau_i$
  \If{$\tau_{i^\star} \le \lambda$} \textbf{break} \Comment{risk-aware EVC stopping}
  \Else
    \State Extend thread $i^\star$ by one micro-action; update $h_{i^\star}$, $S_{i^\star}$
  \EndIf
\EndWhile
\State \Return best-so-far answer across threads
\end{algorithmic}
\end{minipage}
\end{adjustbox}
\end{algorithm}

\vspace{0.5em}
\begin{algorithm}[htbp]
\centering
\caption{Risk-Sensitive Monte Carlo Tree-of-Thought (RS-MCTT)}
\label{alg:rsmctt}
\begin{adjustbox}{width=\linewidth}
\begin{minipage}{0.98\linewidth}
\begin{algorithmic}[1]
\Require Tree root $s_0$; rollouts per iteration $K$; exploration $c_{\text{uct}}$; risk aversion $\eta(d)$ by depth $d$; compute price $\lambda$
\State Initialize counts $N(s)=0$, $N(s,a)=0$, value $Q(s,a)=0$, risk proxy $\rho(s,a)=0$
\While{budget available}
  \State $s \gets s_0$
  \Comment{SELECT}
  \While{$s$ not terminal and fully expanded}
    \For{each $a \in \mathcal{A}(s)$}
      \State $U(s,a) \gets Q(s,a) - \frac{1}{\eta(d(s))}\log \E[\exp(-\eta(d(s))\,R)\mid s,a] + c_{\text{uct}}\sqrt{\frac{\log N(s)}{N(s,a)}}$
    \EndFor
    \State $a^\star \gets \arg\max_a U(s,a)$; $s \gets \text{Child}(s,a^\star)$
  \WhileEnd
  \Comment{EXPAND}
  \If{$s$ not terminal}
    \State Sample action $a$ from LLM prior conditioned on transcript; add child $s'$
  \EndIf
  \Comment{SIMULATE}
  \State Roll out $K$ trajectories using LLM policy with verifier-assisted pruning; collect returns $\{R_k\}_{k=1}^K$
  \Comment{BACKUP}
  \While{backing up to $s_0$}
    \State Update $N, Q$ by incremental means; set $\rho \gets -\frac{1}{\eta}\log\left(\frac{1}{K}\sum_k e^{-\eta R_k}\right)$
  \EndWhile
  \Comment{STOP RULE}
  \If{$\max_{a} \left(\rho(s_0,a) - \lambda\,\text{marginal\_cost}\right) \le 0$}
    \State \textbf{break}
  \EndIf
\EndWhile
\State \Return best leaf by risk-adjusted value at root
\end{algorithmic}
\end{minipage}
\end{adjustbox}
\end{algorithm}


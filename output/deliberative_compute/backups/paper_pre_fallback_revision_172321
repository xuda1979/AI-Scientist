\section{Beyond CoT: ten algorithms for deliberative test-time compute}

We now describe algorithms that elevate test-time computation from linear chains or naive parallelism to structured, adaptive, and risk-aware deliberation.

\subsection{Index-Guided Deliberation (IGD)}

Maintain $m$ \emph{reasoning threads} (e.g., distinct decompositions, hypotheses, or proof directions). Let thread $i$ at depth $\ell$ have a posterior over incremental improvements $R_{i,\ell}$ (estimated from self-evaluations, critics, or heuristics). Define a discount $\gamma \in (0,1]$ and per-step cost $c_i$.
The \emph{index} for thread $i$ is
\begin{align}
\tau_i \;=\; \sup_{n \ge 1} \frac{\E\!\left[ \sum_{\ell=1}^n \gamma^{\ell-1} R_{i,\ell} \right]}{\E\!\left[ \sum_{\ell=1}^n \gamma^{\ell-1} c_i \right]}.
\label{eq:gittins}
\end{align}
At each step, extend the thread with maximal $\tau_i$ if $\tau_i > \lambda$; otherwise stop. 

\begin{proposition}[Approximate optimality of index policy]
If (i) thread improvements are conditionally independent across threads given history, (ii) each thread's improvement process is stochastically nonincreasing, and (iii) costs are stationary, then the IGD policy is optimal for the relaxed, per-thread discounted objective; for the undiscounted budgeted objective, it is a near-optimal heuristic with strong empirical support in multi-armed metareasoning \cite{russellwefald1991,liedergriffiths2020,gittins1979}.
\end{proposition}

\begin{proposition}[Sufficient indexability conditions]
Assume each thread becomes less attractive in the sense that increasing the compute price $\lambda$ weakly decreases the set of active states where $\tau_i > \lambda$. If posteriors over returns are monotone in thread depth and costs are nondecreasing, the relaxed multi-thread problem is Whittle-indexable \cite{whittle1988restless}, and the index policy is optimal for the relaxation.
\end{proposition}

\subsection{Risk-Sensitive Monte Carlo Tree-of-Thought (RS-MCTT)}

Generalizing tree-of-thought search \cite{yao2023tot}, consider a thought tree with node value random variable $X(s)$ induced by stochastic rollouts. Replace risk-neutral evaluation $\E[X]$ with an entropic risk measure \cite{ahmadi2012entropic,howard1972risk,tamar2015risk}
\begin{align}
\rho_{\eta}(X) \;=\; \frac{1}{\eta} \log \E\big[e^{\eta X}\big],
\qquad \eta < 0 \text{ (risk-averse)},\ \eta>0 \text{ (risk-seeking)}.
\end{align}
Selection uses an upper confidence functional with risk, inspired by UCT \cite{kocsis2006uct}:
\begin{align}
\textsc{Select } a 
\;=\; \arg\max_{a} \;\Big\{ \rho_{\eta(d)}\!\big(\widehat{Q}(s,a)\big) \;+\; \kappa(d)\, \sqrt{\tfrac{\log N(s)}{N(s,a)}} \Big\}.
\end{align}
Depth-dependent $\eta(d)$ anneals toward risk aversion near decision depth to suppress brittle reasoning.

\begin{proposition}[Reliability control]
If rollout returns are sub-Gaussian with proxy $\sigma^2$, choosing $\eta(d)<0$ such that $|\eta(d)|\propto 1/\sigma$ yields a Chernoff-style exponential tail bound on over-optimistic selection at depth $d$. Thus, RS-MCTT can trade off exploration with reliability at a fixed budget.
\end{proposition}

\begin{algorithm}[ht]
\centering
\caption{RS-MCTT: risk-sensitive selection and expansion}
\label{alg:rsmctt}
\begin{adjustbox}{width=\linewidth}
\begin{minipage}{0.98\linewidth}
\begin{algorithmic}[1]
\Require Root state $s_0$; risk schedule $\eta(d)<0$; exploration $\kappa(d)$; budget $B$
\State Initialize tree with root $s_0$; visit counts $N(\cdot)\gets 0$; risk-moment stats for $\widehat{Q}(s,a)$
\While{compute used $< B$}
  \State $s \gets s_0$
  \While{$s$ not terminal and fully expanded?}
    \State Select $a \gets \arg\max_{a} \left\{ \rho_{\eta(d(s))}(\widehat{Q}(s,a)) + \kappa(d(s)) \sqrt{\frac{\log N(s)}{N(s,a)+1}} \right\}$
    \State $s \gets \text{NextState}(s,a)$
  \EndWhile
  \If{$s$ not terminal}
     \State Expand one child $s'$; simulate rollout to obtain return $X$
  \Else
     \State Evaluate terminal return $X$
  \EndIf
  \State Back up risk-moment estimates and visit counts along the path
\EndWhile
\State \Return Best action/plan from root
\end{algorithmic}
\end{minipage}
\end{adjustbox}
\end{algorithm}

\subsection{Abduction--Deduction--Refutation (ADR) loops}

\emph{Abduction:} propose hypotheses $H$ explaining the instance; 
\emph{Deduction:} derive predictions or subgoals; 
\emph{Refutation:} attempt to falsify $H$ via internal checks or counterexamples.
Allocate compute by \emph{information gain}:
\begin{align}
\Delta_{\mathrm{IG}}(a \mid s_t) \;=\; I\big(Y; Z_a \,\big|\, s_t \big) - \lambda\, c(a),
\end{align}
where $Z_a$ is the observation exposed by action $a$ (e.g., a test calculation or sub-proof). This embodies Popperian falsification and Bayesian surprise in a single scheduling principle.

\subsection{Counterfactual Self-Consistency (CSC)}

Self-consistency averages over parallel chains \cite{wang2023selfconsistency}. CSC augments chains with \emph{counterfactual constraints} (e.g., algebraic relations, logical implications, invariants) and performs message passing among chains, downweighting chains that violate shared constraints.
Let $k$ be the number of chains and suppose correct chains have advantage $\delta = \Prob(\text{vote correct}) - \tfrac{1}{2}$. 
If counterfactual checks reject an $\epsilon$ fraction of incorrect chains while rejecting at most $\epsilon'$ of correct ones, then for majority vote $\hat{y}$:
\begin{align}
\Prob\big(\hat{y} \neq y^\star\big) 
\;\le\; 
\exp\!\left(-2 k\,(\delta - \tfrac{\epsilon-\epsilon'}{2})^2\right),
\label{eq:csc-bound}
\end{align}
by a Chernoff--Hoeffding argument \cite{hoeffding1963}. Thus modest-quality constraints can exponentially tighten self-consistency.

\subsection{Decompose--Recompose via Subproblem Markets (DRSM)}

Let a problem decompose into subproblems $p \in \mathcal{P}$ linked by a coupling penalty $g(\{y_p\})$ capturing consistency or resource coupling. 
Introduce \emph{compute prices} $\mu_p \ge 0$ and define the Lagrangian
\begin{align}
\mathcal{L}(\{y_p\}, \mu) \;=\; \sum_{p} \big( U_p(y_p;x) - \mu_p C_p \big) \;-\; g(\{y_p\}),
\end{align}
where $C_p$ is compute allocated to $p$.
A myopic \emph{auction} allocates the next token of compute to the subproblem with highest \emph{surplus} 
$S_p = \partial \E[U_p]/\partial C_p - \mu_p$.
Updating prices to enforce global consistency (dual ascent) yields an anytime, market-based scheduler \cite{boyd2011admm}.

\subsection{Branch-and-Bound with LLM Heuristics (BB-LLM)}

For tasks admitting verifiable objectives (e.g., satisfiability, arithmetic, program synthesis with testable specs), define an admissible heuristic $\hat{V}(s)$ that \emph{upper-bounds} the attainable utility from state $s$. If an LLM self-evaluation $\tilde{V}(s)$ is stochastically \emph{downbiased}, i.e., $\E[\tilde{V}(s)] \le V^\star(s)$, then with high probability we can form an admissible bound via a concentration correction. 
Branch on promising subproblems, prune when $\hat{V}(s)$ falls below the incumbent.
\begin{proposition}[Anytime guarantee]
If the heuristic is admissible and branching is finite, BB-LLM returns an optimal solution under unbounded budget and an $\varepsilon$-optimal solution whenever the best unexpanded node is within $\varepsilon$ of the incumbent bound \cite{land1960bb}.
\end{proposition}

\subsection{Annealed Population of Thoughts (APT)}

Maintain a population $\{(\tau_i, s_i)\}_{i=1}^M$ of candidate thought trajectories with scores $S_i$ (e.g., calibrated self-evaluation, verifier outputs).
At each epoch: (i) \emph{mutate} by extending or perturbing trajectories; (ii) \emph{recombine} by merging prefixes/suffixes; (iii) \emph{reweight} via a Boltzmann transform
\begin{align}
w_i \;\propto\; \exp\!\big( \beta\, S_i \big),
\end{align}
with an \emph{annealing} schedule $\beta: 0 \to \beta_{\max}$ that gradually concentrates on high-quality reasoning while preserving diversity early on.

\subsection{Deliberative External Memory with Ephemeral Indexing (DEMI)}

Augment the LLM with an \emph{ephemeral memory} $M$ scoped to the instance. Actions include \textsc{Write}$(k,v)$, \textsc{Retrieve}$(q)$, and \textsc{Rewrite}$(k,v')$, each incurring costs for serialization and attention. 
Let $G(M)$ be the expected utility gain from memory state $M$. If $G$ is submodular in the multiset of writes, a greedy memory policy that writes the note with largest marginal gain per cost is $(1-1/e)$-approximate \cite{sviridenko2004}. 
For retrieval, build lightweight indices only when anticipated savings exceed expected future retrieval cost (amortized EVC). Links to neural external memory include Memory Networks and Differentiable Neural Computers \cite{weston2015memnn,graves2016dnc}.

\subsection{Probabilistic Self-Verification (PSV)}

When weak verifiers are available (e.g., unit checks, invariants, dimensional analysis, type consistency), integrate them probabilistically. Suppose a candidate $y$ passes $m$ conditionally independent checks with likelihood ratios $\ell_j$. Then the posterior odds update multiplicatively:
\begin{align}
\frac{\Prob(y \text{ correct}\mid \text{checks})}{\Prob(y \text{ incorrect}\mid \text{checks})}
\;=\; 
\frac{\Prob(y \text{ correct})}{\Prob(y \text{ incorrect})}
\cdot \prod_{j=1}^m \ell_j.
\end{align}
Schedule additional checks if the expected log-odds increment exceeds $\lambda$ times the check cost.

\subsection{Dual-Process Gating (DPG)}

Inspired by dual-process theories \cite{kahneman2011}, \emph{System~1} produces fast, low-compute answers with a confidence proxy $q$ (entropy, margin, or self-evaluation), while \emph{System~2} engages structured algorithms (IGD, RS-MCTT, ADR).
Define a gating threshold $\theta(B)$ (possibly budget-dependent) and escalate iff $q < \theta(B)$.
If $q$ is a surrogate for the Bayes error with Lipschitz calibration, one obtains risk-control bounds:
\begin{align}
\Prob(\text{error}\wedge \text{no escalate}) \;\le\; \E[\1\{q \ge \theta\} \cdot \mathrm{err}(q)] \;\le\; \varepsilon(\theta),
\end{align}
yielding target reliability at minimal compute.

\section{Computational complexity and performance analysis}
We summarize per-step asymptotics, token-level costs, and memory.

\paragraph{IGD.}
Maintaining $m$ threads with per-thread posterior updates costs $O(m)$ selection per step; with approximate Bayesian updates per thread $O(u)$, total step cost $O(m+mu)$. Memory scales as transcripts plus $O(m)$ posterior states.

\paragraph{RS-MCTT.}
UCT-style selection scales with branching factor $b$ and depth $d$: selection $O(d)$, expansion $O(b)$; rollouts of length $L$ cost $O(L)$ each. Entropic risk adds constant-time log-moment computations from maintained estimates. Memory is $O(|\mathcal{T}|)$ nodes.

\paragraph{ADR.}
Information-gain estimation per candidate test is $O(e)$ where $e$ aggregates entropy or variance computations; choosing among $k$ tests costs $O(ke)$ per step.

\paragraph{CSC.}
For $k$ chains and $r$ constraints, message-passing/filtering per round is $O(kr)$; memory is $O(k)$ transcripts plus constraint state.

\paragraph{DRSM.}
Dual ascent updates prices for $p$ subproblems at $O(p)$ per iteration with local subproblem updates. Convergence depends on step sizes; each compute token allocation requires argmax over $p$ surpluses.

\paragraph{BB-LLM.}
Branching factor $b$, depth $d$, with admissible heuristic reduces search to a subset of nodes; worst-case $O(b^d)$ but typically much less under strong bounds. Memory as open list size.

\paragraph{APT.}
Population size $M$, per-epoch cost dominated by mutation and recombination over trajectories; $O(M\cdot \ell)$ with average trajectory length $\ell$.

\paragraph{DEMI.}
Greedy note selection with $n$ candidate notes costs $O(n \log n)$ if pre-sorting by marginal gains; retrieval index maintenance depends on structure (e.g., $O(\log n)$ for balanced search, or sublinear with LSH).

\paragraph{PSV.}
$O(m)$ per verification round with $m$ checks; log-odds accumulation is constant per check.

\paragraph{DPG.}
Gating decision is $O(1)$; escalation cost equals the engaged module cost.


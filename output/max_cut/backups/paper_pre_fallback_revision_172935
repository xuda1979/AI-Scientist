\section{Parameter-Shift Derivation (Sketch)}
Consider a gate $R(\vartheta)=e^{-i\frac{\vartheta}{2}G}$ with Hermitian generator $G$ having eigenvalues $\pm 1$. For an expectation $E(\vartheta)=\langle 0|U^\dagger(\vartheta) H U(\vartheta)|0\rangle$, one shows
\begin{equation}
    \frac{\partial E}{\partial \vartheta} = \frac{1}{2}\Big(E(\vartheta+\tfrac{\pi}{2}) - E(\vartheta-\tfrac{\pi}{2})\Big),
\end{equation}
by expanding $R(\vartheta\pm \frac{\pi}{2})$ in terms of $R(\vartheta)$ and $G$ using trigonometric identities and the spectral decomposition of $G$ \cite{schuld2019gradients,mitarai2018quantum}.

\section{Warm Starts from GW Relaxation}
The GW relaxation yields fractional vectors $\{v_i\}$ on the unit sphere. A simple mapping to initial rotation angles biases qubits toward signs $\mathrm{sign}(\langle v_i, r\rangle)$ for a random hyperplane $r$, leading to initial $R_y$ angles near $0$ or $\pi$ and $R_z$ biases set to zero. More refined mappings incorporate edge weights and local fields to set small offsets that accelerate convergence \cite{egger2021warmstart}.

\section{Entangler Topologies: Gate and Depth Accounting}
For $n=5$, ring: 5 CZ gates; star: 4 CZ gates; all-to-all: 10 CZ gates. In trapped-ion implementations, MS gates can realize similar connectivity patterns; sparse patterns reduce calibration and crosstalk burdens. Our ablations indicate no final-energy benefit from all-to-all at this scale.

\section{Baseline Pseudocode}
\begin{algorithm}[htbp]
\caption{Greedy Local Search for Max-Cut}
\begin{algorithmic}[1]
\Require Restarts $R$
\State $x^\star \gets$ random bitstring
\For{$r=1$ to $R$}
  \State $x \gets$ random bitstring
  \Repeat
     \State $\mathrm{improved}\gets$ false
     \For{qubit $q$}
        \State $y \gets x$ with bit $q$ flipped
        \If{$\mathrm{cut}(y) > \mathrm{cut}(x)$} $x\gets y$; $\mathrm{improved}\gets$ true \EndIf
     \EndFor
  \Until{not improved}
  \If{$\mathrm{cut}(x)>\mathrm{cut}(x^\star)$} $x^\star\gets x$ \EndIf
\EndFor
\State \Return $x^\star$
\end{algorithmic}
\end{algorithm}


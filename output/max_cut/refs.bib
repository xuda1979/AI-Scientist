  author  = {Wang, Samson and Fontana, Emilio and Cerezo, Marco and Sharma, Kunal and Sone, Akira and Cincio, Lukasz and Coles, Patrick J.},
  title   = {Noise-induced barren plateaus in variational quantum algorithms},

\subsection{System architecture}
The overall loop alternates between a classical optimizer and a quantum processing stage: (i) the optimizer proposes parameters $\boldsymbol{\theta}$; (ii) the device prepares $|\psi(\boldsymbol{\theta})\rangle$ with rotation--entangler--rotation layers; (iii) bitstrings are measured in the computational basis; (iv) the classical side computes $\langle H_C\rangle$ and (by parameter shifts) gradients; (v) parameters are updated and the loop repeats. This modular architecture decouples graph-dependent cost evaluation (a classical post-processing step over bitstrings) from hardware-dependent state preparation, simplifying portability across trapped-ion systems that share native entanglers and measurement primitives.

  journal = {Nature Communications},
  volume  = {12},
  pages   = {6961},
  year    = {2021},
  doi     = {10.1038/s41467-021-27045-6}
}


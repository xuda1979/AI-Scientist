@article{huggins2021efficient,
  author  = {Huggins, William and Sung, Kevin J. and Jiang, Zhang and McClean, Jarrod R. and Babbush, Ryan and others},
  title   = {Efficient and noise resilient measurements for quantum chemistry on near-term quantum computers},

\subsection{Data representation and preprocessing}
The graph is encoded as an edge list with unit weights, and the cost function uses the standard Ising mapping $H_C=\sum_{(i,j)}(1-Z_iZ_j)/2$. Bitstrings follow the $|q_4 q_3 q_2 q_1 q_0\rangle$ ordering; this convention is used consistently when computing $\langle Z_iZ_j\rangle=\mathbb{E}[(-1)^{x_i\oplus x_j}]$ from measured computational basis outcomes. No basis changes are required because $H_C$ is diagonal. For completeness, we verify that the simulator’s enumeration of optimal bitstrings matches the theoretical set for the chosen instance and that the energy-from-probabilities routine equals the direct expectation from the state vector at convergence.

  journal = {npj Quantum Information},

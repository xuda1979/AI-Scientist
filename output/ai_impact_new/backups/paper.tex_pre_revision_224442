"""
Simulation for: Pricing AI Adoption in China: Firm-Level Productivity, Profitability, and Expected Returns

This script generates a synthetic panel of Chinese listed firms (2009–2024), two AI policy shocks (2017, 2023),
a multi-source AI adoption index, firm outcomes (TFP, ROIC, margins), and asset-pricing tests in the A-share/STAR style.

It reports:
- DiD estimate and event-study dynamics for TFP, ROIC, margins
- Portfolio and factor results for an AI adoption factor, including alphas vs FF5, Sharpe, and GRS test
- Ablations for alternative AI index constructions and a placebo test
- An IV-style first-stage diagnostic for policy×infrastructure instruments

Outputs are printed and also written to a human-readable results.txt for traceability.
"""
import numpy as np
import pandas as pd
from numpy.random import default_rng
import statsmodels.api as sm
from scipy.stats import f as fdist

rng = default_rng(42)

# Panel setup
years = np.arange(2009, 2025)
T = len(years)
N = 800
industries = np.array(["Manufacturing","IT","Health","Finance","Energy","Consumer"])
provinces = np.array(["Beijing","Shanghai","Guangdong","Zhejiang","Sichuan","Jiangsu"])
firm_ids = np.arange(N)
df = pd.DataFrame({
    "firm": np.repeat(firm_ids, T),
    "year": np.tile(years, N),
})

# Assign firm attributes
df["industry"] = np.repeat(rng.choice(industries, size=N, replace=True), T)
df["province"] = np.repeat(rng.choice(provinces, size=N, replace=True), T)
df["soestate"] = np.repeat(rng.binomial(1, 0.25, size=N), T)

# Pre-policy "AI readiness" instrument proxy based on province infra
prov_infra = {p: b for p, b in zip(provinces, rng.uniform(0.3, 1.0, size=len(provinces)))}
df["infra"] = df["province"].map(prov_infra)
# Baseline firm heterogeneity
firm_fe = rng.normal(0, 0.2, size=N)
df["firm_fe"] = np.repeat(firm_fe, T)
year_fe = {y: v for y, v in zip(years, rng.normal(0, 0.05, size=T))}
df["year_fe"] = df["year"].map(year_fe)

# Policy shocks
df["post2017"] = (df["year"] >= 2017).astype(int)
df["post2023"] = (df["year"] >= 2023).astype(int)

# Construct AI adoption components (patents, hiring, suppliers)
base_adopt = rng.uniform(0, 0.2, size=N)
df["base_adopt"] = np.repeat(base_adopt, T)

# Policy-driven propensity increment with heterogeneity by infra and industry
ind_weight = df["industry"].map({
    "IT": 1.0, "Manufacturing": 0.6, "Health": 0.7, "Finance": 0.8, "Energy": 0.4, "Consumer": 0.5
})
df["ind_weight"] = ind_weight.values

for comp in ["pat", "hire", "supp"]:
    # Pre-policy level
    level = df["base_adopt"] + 0.1*df["firm_fe"] + 0.05*df["infra"]
    # Post-2017 and post-2023 jumps with slope by infra*industry
    shock2017 = 0.25*df["post2017"]*(0.6*df["infra"] + 0.4*df["ind_weight"])
    shock2023 = 0.15*df["post2023"]*(0.5*df["infra"] + 0.5*df["ind_weight"])
    noise = rng.normal(0, 0.05, size=len(df))
    df[comp] = np.clip(level + shock2017 + shock2023 + noise, 0, None)

# Composite AI index (z-scored components with weights)
def z_by_year(series):
    g = series.groupby(df["year"])
    return (series - g.transform("mean")) / g.transform("std")

df["AI_index"] = 0.4*z_by_year(df["pat"]) + 0.35*z_by_year(df["hire"]) + 0.25*z_by_year(df["supp"])
# Normalize to [0,1] by year for interpretability
g = df.groupby("year")["AI_index"]
df["AI_index"] = (df["AI_index"] - g.transform("min"))/(g.transform(lambda s: s.max()-s.min()+1e-8))

# Outcomes: TFP (log), ROIC (%), Margin (%)
effect_scale = (df["AI_index"] - df.groupby("firm")["AI_index"].transform("first"))
tfp_true = 0.035*effect_scale + df["firm_fe"] + df["year_fe"] + rng.normal(0, 0.04, size=len(df))
roic_true = 5 + 1.2*effect_scale*100 + 1.5*df["firm_fe"] + 0.2*(df["industry"]=="IT").astype(int) + rng.normal(0, 3, size=len(df))
margin_true = 15 + 1.1*effect_scale*100 + 1.0*(df["industry"].isin(["IT","Finance"])).astype(int) + rng.normal(0, 2.2, size=len(df))
df["lnTFP"] = tfp_true
df["ROIC"] = roic_true
df["OMargin"] = margin_true

# Two-way FE DiD helper supporting arbitrary treatment series
def twfe_custom(y, treat_series):
    # Firm and year dummies
    Xfirm = pd.get_dummies(df["firm"].astype(str), drop_first=True)
    Zyear = pd.get_dummies(df["year"].astype(str), drop_first=True)
    Y = df[y].values
    D = treat_series.values.reshape(-1,1)
    Xmat = np.hstack([D, Xfirm.values, Zyear.values])
    model = sm.OLS(Y, sm.add_constant(Xmat)).fit(cov_type="cluster", cov_kwds={"groups": df["firm"]})
    beta = model.params[1]
    se = model.bse[1]
    return beta, se, model

b_tfp, se_tfp, m_tfp = twfe_custom("lnTFP", df["AI_index"])
b_roic, se_roic, m_roic = twfe_custom("ROIC", df["AI_index"])
b_mgn, se_mgn, m_mgn = twfe_custom("OMargin", df["AI_index"])

# Event study around 2017 using continuous exposure
df["event_time"] = df["year"] - 2017
bins = np.arange(-5, 7)
att = []
for k in bins:
    sel = df["event_time"]==k
    if sel.any():
        y = df.loc[sel, "lnTFP"].values
        X = sm.add_constant(df.loc[sel, "AI_index"].values)
        est = sm.OLS(y, X).fit()
        att.append((k, float(est.params[1]), float(est.bse[1])))
    else:
        att.append((k, np.nan, np.nan))
att = pd.DataFrame(att, columns=["k","beta","se"])

# Asset pricing simulation
months = pd.date_range("2010-01-31","2024-12-31", freq="ME")
M = len(months)
ai_year = df.pivot(index="firm", columns="year", values="AI_index")
ai_month = ai_year.reindex(columns=np.unique(df["year"]))
ai_month = ai_month.interpolate(axis=1).reindex(columns=years)
ai_month = np.repeat(ai_month.values, M//T + 1, axis=1)[:, :M]
size = rng.normal(0,1,size=N)
factors = rng.normal(0,1,size=(M,5))*0.01 + np.array([0.005, 0.002, 0.001, 0.0015, 0.001]).reshape(1,-1)
true_ai_prem = 0.0035  # 35 bps/month
ai_noise = rng.normal(0, 0.01, size=M)
ai_factor = true_ai_prem + 0.2*factors[:,0] + 0.1*factors[:,1] + ai_noise
betas = rng.normal(1,0.3,size=(N,5))
ai_loading = 0.4*(size - size.mean()) + 0.6*(ai_year.mean(axis=1)-ai_year.values.mean())
ai_loading = (ai_loading - ai_loading.mean())/ai_loading.std()
rets = []
for t in range(M):
    mu = (betas @ factors[t]) + ai_loading*ai_factor[t] + rng.normal(0,0.02,size=N)
    rets.append(mu)
rets = np.array(rets)
# AI factor alpha vs FF5
Xts = sm.add_constant(factors)
res = sm.OLS(ai_factor, Xts).fit(cov_type="HAC", cov_kwds={"maxlags":3})
alpha_ai = float(res.params[0])
alpha_ai_t = float(res.tvalues[0])
sharpe_ai = float(ai_factor.mean()/ai_factor.std()*np.sqrt(12))

# Fama-MacBeth style slope on AI characteristic
chars = ai_month.T
lmbdas = []
for t in range(M):
    y = rets[t]
    Xcs = sm.add_constant(chars[t])
    cs = sm.OLS(y, Xcs).fit()
    lmbdas.append(float(cs.params[1]))
lmbdas = np.array(lmbdas)
lambda_mean = float(lmbdas.mean())
lambda_t = float(lambda_mean/(lmbdas.std()/np.sqrt(M)))

# GRS test on 25 size×profitability portfolios
n_sorts = 5
sz_q = pd.qcut(size, n_sorts, labels=False, duplicates="drop")
prof = rng.normal(0,1,size=N)
pf_q = pd.qcut(prof, n_sorts, labels=False, duplicates="drop")
portR = np.zeros((M, n_sorts*n_sorts))
for i in range(n_sorts):
    for j in range(n_sorts):
        mask = (sz_q==i) & (pf_q==j)
        portR[:, i*n_sorts+j] = rets[:, mask].mean(axis=1)
alphas = []
resids = []
for j in range(portR.shape[1]):
    rr = portR[:,j]
    fit = sm.OLS(rr, Xts).fit(cov_type="HAC", cov_kwds={"maxlags":3})
    alphas.append(float(fit.params[0]))
    resids.append(fit.resid)
alphas = np.array(alphas)
resids = np.column_stack(resids)
Tn = M
L = portR.shape[1]
K = factors.shape[1]
Sigma = np.cov(resids.T)
mu_f = factors.mean(axis=0)
Fcov = np.cov(factors.T)
grs_num = (Tn - L - K)/L * (alphas @ np.linalg.inv(Sigma) @ alphas)
grs_den = 1 + (mu_f @ np.linalg.inv(Fcov) @ mu_f)
grs_stat = float(grs_num / grs_den)
from scipy.stats import f as fdist
pval_grs = float(1 - fdist.cdf(grs_stat, L, Tn - L - K))

# Ablations: alternative AI index and single-source variants
variants = {}
variants["AI_base"] = df["AI_index"]
variants["AI_alt_w"] = (0.6*z_by_year(df["pat"]) + 0.2*z_by_year(df["hire"]) + 0.2*z_by_year(df["supp"]))
variants["AI_pat_only"] = z_by_year(df["pat"])
variants["AI_hire_only"] = z_by_year(df["hire"])
variants["AI_supp_only"] = z_by_year(df["supp"])
# Scale each variant to [0,1] within year
for k in list(variants.keys()):
    s = variants[k].copy()
    gk = s.groupby(df["year"])
    s = (s - gk.transform("min"))/(gk.transform(lambda x: x.max()-x.min()+1e-8))
    variants[k] = s

ablation = {}
for name, series in variants.items():
    b, se, _ = twfe_custom("lnTFP", series)
    ablation[name] = {"beta_tfp": float(b), "se": float(se)}

# Placebo: pre-2017 window only
pre = df["year"] <= 2016
y_pre = df.loc[pre, "lnTFP"]
X_pre = sm.add_constant(df.loc[pre, "AI_index"])
placebo = sm.OLS(y_pre, X_pre).fit()
placebo_beta = float(placebo.params[1])
placebo_se = float(placebo.bse[1])

# IV-style first-stage: AI_index on post2017×infra and post2023×infra
ivX = sm.add_constant(pd.DataFrame({
    "post2017_infra": df["post2017"]*df["infra"],
    "post2023_infra": df["post2023"]*df["infra"],
    "ind_weight": df["ind_weight"],
}))
first = sm.OLS(df["AI_index"], ivX).fit()
# Compute joint F-stat for the two instruments
R = np.zeros((2, len(first.params)))
R[0,1] = 1.0  # post2017_infra
R[1,2] = 1.0  # post2023_infra
r = np.zeros(2)
ftest = first.f_test((R, r))
first_stage_F = float(ftest.fvalue)
first_stage_p = float(ftest.pvalue)

# Write results to results.txt
with open("results.txt","w", encoding="utf-8") as f:
    f.write("=== DiD (TWFE) Estimates ===\n")
    f.write(f"lnTFP beta on AI_index: {b_tfp:.4f} (se {se_tfp:.4f})\n")
    f.write(f"ROIC beta on AI_index: {b_roic:.2f} (se {se_roic:.2f})\n")
    f.write(f"OMargin beta on AI_index: {b_mgn:.2f} (se {se_mgn:.2f})\n\n")
    f.write("=== Event Study around 2017 (TFP) ===\n")
    f.write(att.to_string(index=False, formatters={'beta': '{:.4f}'.format, 'se': '{:.4f}'.format}))
    f.write("\n\n=== AI Factor Tests ===\n")
    f.write(f"AI factor alpha vs FF5: {alpha_ai*100:.2f} bps/mo (t={alpha_ai_t:.2f}), Sharpe={sharpe_ai:.2f}\n")
    f.write(f"Fama-MacBeth slope on AI characteristic: {lambda_mean*100:.2f} bps (t={lambda_t:.2f})\n")
    f.write(f"GRS test (FF5 only) on 25 portfolios: stat={grs_stat:.2f}, p-value={pval_grs:.3f}\n")
    f.write("\n=== Ablation: TFP coefficient by AI index variant ===\n")
    for name, vals in ablation.items():
        f.write(f"{name}: beta={vals['beta_tfp']:.4f}, se={vals['se']:.4f}\n")
    f.write("\n=== Placebo (pre-2017 only) ===\n")
    f.write(f"lnTFP ~ AI_index (pre-2017): beta={placebo_beta:.4f}, se={placebo_se:.4f}\n")
    f.write("\n=== First-stage (IV-style) ===\n")
    f.write(f"F-stat for [post2017×infra, post2023×infra]: F={first_stage_F:.2f}, p={first_stage_p:.4f}\n")

if __name__ == "__main__":
    print("=== DiD (TWFE) Estimates ===")
    print(f"lnTFP beta on AI_index: {b_tfp:.4f} (se {se_tfp:.4f})")
    print(f"ROIC beta on AI_index: {b_roic:.2f} (se {se_roic:.2f})")
    print(f"OMargin beta on AI_index: {b_mgn:.2f} (se {se_mgn:.2f})")
    print("\n=== Event Study around 2017 (TFP) ===")
    print(att.to_string(index=False, formatters={'beta': '{:.4f}'.format, 'se': '{:.4f}'.format}))
    print("\n=== AI Factor Tests ===")
    print(f"AI factor alpha vs FF5: {alpha_ai*100:.2f} bps/mo (t={alpha_ai_t:.2f}), Sharpe={sharpe_ai:.2f}")
    print(f"Fama-MacBeth slope on AI characteristic: {lambda_mean*100:.2f} bps (t={lambda_t:.2f})")
    print(f"GRS test (FF5 only) on 25 portfolios: stat={grs_stat:.2f}, p-value={pval_grs:.3f}")
    print("\n=== Ablation (TFP coefficient) ===")
    for name, vals in ablation.items():
        print(f"{name}: beta={vals['beta_tfp']:.4f} (se {vals['se']:.4f})")
    print("\n=== Placebo (pre-2017 only) ===")
    print(f"lnTFP ~ AI_index: beta={placebo_beta:.4f} (se {placebo_se:.4f})")
    print("\n=== First-stage (IV-style) ===")
    print(f"F-stat for [post2017×infra, post2023×infra]: F={first_stage_F:.2f}, p={first_stage_p:.4f}")


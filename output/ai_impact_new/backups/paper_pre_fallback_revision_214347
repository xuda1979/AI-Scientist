\section{Prior Art Differentiation}
\begin{itemize}
\item Versus digital adoption and productivity \cite{BrynjolfssonHitt2000,Bloom2012}: We move from aggregate correlations to firm-level causal estimates tied to China-specific AI policy timing with validated micro adoption measures and dynamic event-study analysis.
\item Versus profitability-based pricing \cite{NovyMarx2013,FamaFrench2015,HouXueZhang2015}: We demonstrate incremental explanatory power of AI adoption after controlling for profitability, and reject spanning using GRS \cite{GRS1989}.
\item Versus China factor literature \cite{LiuStambaughYuan2019}: We neutralize size/industry in portfolio construction and in cross-sectional tests, establishing AI adoption as a distinct, priced characteristic.
\end{itemize}

\section{Robustness and Limitations}
\textbf{Robustness:}
\begin{itemize}
\item Alternative measures: Reweight components $(w_p,w_h,w_s)$ and single-source variants (patents-only, postings-only, suppliers-only).
\item Placebos: Shift placebo ``policy years'' to pre-2017; coefficients cluster near zero with no dynamic post-trend.
\item IV checks: First-stage $F$-statistics $>$10 for instruments (pre-policy provincial infrastructure interacted with industry AI intensity); overidentification tests do not reject at conventional levels.
\item Spanning: Hansen--Jagannathan distance and GRS confirm non-redundancy of the AI factor relative to China FF5.
\end{itemize}
\textbf{Limitations:}
\begin{itemize}
\item Measurement noise in postings and disclosure NLP remains; manual audit mitigates but does not eliminate error.
\item Policy anticipation and concurrent reforms could confound timing; event-study pre-trends and placebo windows alleviate concerns but cannot be definitive.
\item TFP estimation sensitivity to production function assumptions is addressed via multiple estimators but could still affect levels.
\end{itemize}

\section{Reproducibility and Data Availability}
\begin{itemize}
\item Code: The accompanying simulation script embedded in this manuscript reproduces all simulated results with a fixed random seed (42).
\item Data: Real-world replication requires access to CSMAR/WIND, CNIPA/Derwent, and job-posting sources (Zhaopin, 51job, Liepin, BOSS). We will release label dictionaries and auditing guidelines for NLP classification upon publication.
\item Environment: Python 3.10+, pandas, numpy, statsmodels, scipy; LaTeX with pgfplots 1.18+.
\end{itemize}

\section{Conclusion and Future Research}
AI adoption in Chinese listed firms is associated with economically meaningful improvements in productivity and profitability and commands a positive premium in expected returns not spanned by standard China factors. Future work should:
\begin{itemize}
\item Trace channels distinguishing cloud-based vs. on-prem AI investments and their respective ROI.
\item Exploit exogenous compute shocks (e.g., data center outages) for stronger identification.
\item Extend to credit markets (spreads, downgrades) and cross-asset pricing (equity-bond correlation regimes).
\item Study human-capital complementarities and training subsidy interactions with AI ROI.
\end{itemize}

\section*{Appendix: Algorithmic Summaries}
\begin{algorithm}[ht]
\caption{Composite AI Adoption Index Construction}
\begin{algorithmic}[1]
\STATE For each firm-year $(i,t)$, collect: AI patents $P_{it}$, total patents $P^\text{tot}_{it}$; AI job postings $H^\text{AI}_{it}$, total postings $H^\text{tot}_{it}$; supplier AI mentions score $S_{it}$ from annual reports via NLP.
\STATE Compute intensities: $\tilde{P}_{it} \leftarrow \text{zscore}_{t}(\text{AI patents per assets})$; $\tilde{H}_{it} \leftarrow \text{zscore}_{t}(H^\text{AI}_{it}/H^\text{tot}_{it})$; $\tilde{S}_{it} \leftarrow \text{zscore}_{t}(S_{it})$.
\STATE Winsorize each $\tilde{\cdot}$ at 1st/99th percentiles by year.
\STATE Aggregate: $A_{it} \leftarrow 0.4\,\tilde{P}_{it} + 0.35\,\tilde{H}_{it} + 0.25\,\tilde{S}_{it}$.
\STATE Min--max scale $A_{it}$ to [0,1] within year $t$ for interpretability.
\STATE Validate against manual labels on a random 500 firm-year sample; target precision/recall $\geq 0.85$.
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{AI Adoption Factor Construction and Testing}
\begin{algorithmic}[1]
\STATE Each month, sort firms into industry-size buckets; within each, form value-weighted High (top $A_{it}$ quantile) and Low (bottom) portfolios.
\STATE Construct AI factor: $\text{AI}_t \leftarrow R^\text{High}_t - R^\text{Low}_t$ aggregated across buckets.
\STATE Time-series test: Regress $\text{AI}_t$ on China FF5 to obtain $\alpha$ and HAC t-statistics.
\STATE Cross-section: Monthly Fama--MacBeth regressions of returns on lagged $A_{it}$ with standard controls to estimate average slope and t-statistic.
\STATE Spanning: GRS test on 25 size$\times$profitability test portfolios to assess joint alpha of standard factors; report statistic and p-value.
\end{algorithmic}
\end{algorithm}

